{
  "name": "@fmidev/smartmet-alert-client",
  "version": "4.7.26",
  "description": "Web application for viewing weather and flood alerts",
  "author": "Finnish Meteorological Institute",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.iife.js",
  "jsdelivr": "dist/index.iife.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "import": "./dist/vue/index.mjs",
      "types": "./dist/vue/vue.d.ts"
    },
    "./vue/style.css": "./dist/vue/style.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmidev/smartmet-alert-client.git"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build && npm run build:vue",
    "build:ce": "vite build",
    "build:vue": "BUILD_MODE=vue vite build",
    "serve": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "snapshots:review": "vite-node scripts/review-snapshots.ts",
    "optimize:svg": "svgo -f src/assets/img --recursive",
    "prepare": "husky",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "@xmldom/xmldom": "0.9.12",
    "cross-fetch": "4.1.0",
    "dompurify": "3.4.17",
    "flatbush": "4.6.2",
    "he": "1.2.0",
    "husky": "9.1.7",
    "svgpath": "2.6.0",
    "vue": "3.5.44",
    "vue-web-component-wrapper": "1.7.7",
    "xpath": "0.0.35"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/he": "1.2.3",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-vue": "10.11.1",
    "fs-extra": "11.4.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "jsdom": "30.1.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "postcss-prefixwrap": "1.53.0",
    "postcss-url": "10.1.4",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.105.1",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vite-plugin-banner": "0.8.1",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "prettier": {
    "bracketSpacing": true,
    "bracketSameLine": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "semi": false
  },
  "bugs": {
    "url": "https://github.com/fmidev/smartmet-alert-client/issues"
  },
  "homepage": "https://github.com/fmidev/smartmet-alert-client#readme",
  "engines": {
    "npm": ">=10.9.7",
    "node": ">=22.22.2"
  },
  "keywords": [
    "smartmet",
    "weather",
    "alert",
    "wfs"
  ]
}
