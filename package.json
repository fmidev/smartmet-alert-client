{
  "name": "@fmidev/smartmet-alert-client",
  "version": "4.5.0",
  "description": "Web application for viewing weather and flood alerts",
  "author": "Finnish Meteorological Institute",
  "license": "MIT",
  "main": "dist/index.mjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmidev/smartmet-alert-client.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "cross-fetch": "^3.1.8",
    "dompurify": "^3.2.7",
    "flatbush": "^3.2.1",
    "he": "^1.2.0",
    "svgpath": "^2.6.0",
    "vue": "^3.4.38",
    "vue-web-component-wrapper": "^1.7.5",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-standard": "^8.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-plugin-vue": "^9.19.2",
    "fs-extra": "^11.2.0",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.0.1",
    "postcss-prefixwrap": "^1.53.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.1.1",
    "rollup-plugin-visualizer": "^5.11.0",
    "sass": "^1.93.2",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.8",
    "vite-plugin-banner": "^0.7.1",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^3.2.4"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "@vue/standard",
      "plugin:vue/recommended",
      "plugin:sonarjs/recommended",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "simple-import-sort"
    ],
    "rules": {
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error"
    }
  },
  "prettier": {
    "bracketSpacing": true,
    "bracketSameLine": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "semi": false
  },
  "bugs": {
    "url": "https://github.com/fmidev/smartmet-alert-client/issues"
  },
  "homepage": "https://github.com/fmidev/smartmet-alert-client#readme",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=14.0.0"
  },
  "keywords": [
    "smartmet",
    "weather",
    "alert",
    "wfs"
  ]
}
